<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>AnyCPU</Platforms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.2"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2"/>
        <PackageReference Include="Photino.NET" Version="4.0.16"/>
        <PackageReference Include="Photino.NET.Server" Version="4.0.12"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Zylance.Core\Zylance.Core.csproj"/>
        <ProjectReference Include="..\Zylance.UI\Zylance.UI.csproj"/>
        <ProjectReference Include="..\Zylance.Vault.Local\Zylance.Vault.Local.csproj"/>
    </ItemGroup>

    <Target Name="CopyUIAssets" AfterTargets="Build">
        <ItemGroup>
            <UIDistFiles Include="..\Zylance.UI\dist\**\*"/>
        </ItemGroup>
        <Copy SourceFiles="@(UIDistFiles)"
              DestinationFolder="$(OutputPath)wwwroot\%(RecursiveDir)"
              SkipUnchangedFiles="true"/>
    </Target>

    <!-- Include wwwroot in publish output -->
    <ItemGroup>
        <Content Include="$(OutputPath)wwwroot\**\*" CopyToPublishDirectory="PreserveNewest" Link="wwwroot\%(RecursiveDir)%(FileName)%(Extension)"/>
    </ItemGroup>
</Project>
