# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly set text files to use LF
*.cs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.proto text eol=lf
*.xml text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.config text eol=lf
*.props text eol=lf
*.targets text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.dll binary
*.exe binary
