<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- RID-agnostic library - consuming project specifies RID (browser-wasm, win-x64, etc) -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.5"/>
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <YarnExe Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(NODE_HOME)' != ''">$(NODE_HOME)\yarn.cmd</YarnExe>
    <YarnExe Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(NODE_HOME)' == ''">yarn.cmd</YarnExe>
    <YarnExe Condition="!$([MSBuild]::IsOSPlatform('Windows')) and '$(NODE_HOME)' != ''">$(NODE_HOME)/bin/yarn</YarnExe>
    <YarnExe Condition="!$([MSBuild]::IsOSPlatform('Windows')) and '$(NODE_HOME)' == ''">yarn</YarnExe>
    <TsOutputPath>../Zylance.UI/Generated/</TsOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="./zylance/**/*.proto" GrpcServices="None"/>
  </ItemGroup>

  <Target Name="CleanGeneratedFiles" BeforeTargets="Clean">
    <RemoveDir Directories="Generated"/>
  </Target>

  <Target
    Name="InstallYarnPackages"
    BeforeTargets="GenerateCode"
    Inputs="package.json;yarn.lock"
    Outputs="$(IntermediateOutputPath)yarn.install.marker"
  >
    <Exec Command="$(YarnExe) install"/>
    <Touch Files="$(IntermediateOutputPath)yarn.install.marker" AlwaysCreate="true"/>
  </Target>

  <Target
    Name="GenerateCode"
    BeforeTargets="BeforeCompile"
  >
    <Exec
      Command="$(YarnExe) build:code"
      EnvironmentVariables="NO_COLOR=1; NODE_DISABLE_COLORS=1"
    />
    <ItemGroup>
      <!-- Include generated C# files in compilation -->
      <GeneratedCSharpFiles Include="Generated/cs/**/*.cs"/>
      <!-- Avoid duplicate default Compile items for generated files -->
      <Compile Remove="Generated/cs/**/*.cs"/>
      <!-- Explicitly compile generated C# files -->
      <Compile Include="@(GeneratedCSharpFiles)"/>
    </ItemGroup>
  </Target>
</Project>
