<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Fleck" Version="1.2.0" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zylance.Core\Zylance.Core.csproj" />
    <ProjectReference Include="..\Zylance.UI\Zylance.UI.csproj" />
    <ProjectReference Include="..\Zylance.Vault.Local\Zylance.Vault.Local.csproj" />
  </ItemGroup>

  <!-- Collect UI dist files for incremental build tracking -->
  <ItemGroup>
    <UIDistFiles Include="..\Zylance.UI\dist\**\*" />
    <UIDistFiles Remove="..\Zylance.UI\dist\**" />
  </ItemGroup>

  <Target
    Name="CopyUIAssets"
    AfterTargets="Build"
    Inputs="@(UIDistFiles)"
    Outputs="@(UIDistFiles->'$(OutputPath)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
  >
    <Copy
      SourceFiles="@(UIDistFiles)"
      DestinationFolder="$(OutputPath)wwwroot\%(RecursiveDir)"
      SkipUnchangedFiles="true"
    />
  </Target>

  <ItemGroup>
    <Content
      Include="$(OutputPath)wwwroot\**\*"
      CopyToPublishDirectory="PreserveNewest"
      Link="wwwroot\%(RecursiveDir)%(FileName)%(Extension)"
    />
    <Content Remove="bin\Debug\net10.0\wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="bin\Debug\net10.0\wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="bin\Debug\net10.0\wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="bin\Debug\net10.0\wwwroot\**" />
  </ItemGroup>
</Project>
