<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- RID-agnostic library - consuming project specifies RID (browser-wasm, win-x64, etc) -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.5"/>
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <YarnExe Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(NODE_HOME)' != ''">$(NODE_HOME)\yarn.cmd</YarnExe>
    <YarnExe Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(NODE_HOME)' == ''">yarn.cmd</YarnExe>
    <YarnExe Condition="!$([MSBuild]::IsOSPlatform('Windows')) and '$(NODE_HOME)' != ''">$(NODE_HOME)/bin/yarn</YarnExe>
    <YarnExe Condition="!$([MSBuild]::IsOSPlatform('Windows')) and '$(NODE_HOME)' == ''">yarn</YarnExe>
    <TsOutputPath>../Zylance.UI/Generated/</TsOutputPath>
    <!-- Marker files for incremental build tracking -->
    <YarnInstallMarker>$(BaseIntermediateOutputPath)yarn.install.marker</YarnInstallMarker>
    <YarnBuildMarker>$(BaseIntermediateOutputPath)yarn.build.marker</YarnBuildMarker>
  </PropertyGroup>

  <!-- Files that trigger code regeneration when modified -->
  <ItemGroup>
    <Protobuf Include="./zylance/**/*.proto" GrpcServices="None"/>
    <CodeGenInputs Include="Scripts/**/*.ts"/>
    <CodeGenInputs Include="package.json"/>
    <CodeGenInputs Include="yarn.lock"/>
  </ItemGroup>

  <Target Name="CleanGeneratedFiles" BeforeTargets="Clean">
    <RemoveDir Directories="Generated"/>
    <Delete Files="$(YarnInstallMarker);$(YarnBuildMarker)"/>
  </Target>

  <Target
    Name="InstallYarnPackages"
    BeforeTargets="GenerateCode"
    Inputs="package.json;yarn.lock"
    Outputs="$(YarnInstallMarker)"
  >
    <MakeDir Directories="$(BaseIntermediateOutputPath)"/>
    <Exec Command="$(YarnExe) install"/>
    <Touch Files="$(YarnInstallMarker)" AlwaysCreate="true"/>
  </Target>

  <Target
    Name="GenerateCode"
    DependsOnTargets="InstallYarnPackages"
    BeforeTargets="BeforeCompile"
    Inputs="@(ProtoBuf);@(CodeGenInputs)"
    Outputs="$(YarnBuildMarker)"
  >
    <MakeDir Directories="$(BaseIntermediateOutputPath)"/>
    <Exec Command="$(YarnExe) build:code" EnvironmentVariables="NO_COLOR=1; NODE_DISABLE_COLORS=1"/>
    <ItemGroup>
      <!-- Include generated C# files in compilation -->
      <GeneratedCSharpFiles Include="Generated/cs/**/*.cs"/>
      <!-- Avoid duplicate default Compile items for generated files -->
      <Compile Remove="Generated/cs/**/*.cs"/>
      <!-- Explicitly compile generated C# files -->
      <Compile Include="@(GeneratedCSharpFiles)"/>
    </ItemGroup>
    <Touch Files="$(YarnBuildMarker)" AlwaysCreate="true"/>
  </Target>
</Project>
