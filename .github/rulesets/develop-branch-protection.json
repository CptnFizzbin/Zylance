{
  "name": "Develop Branch Protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/develop"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "pull_request"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "required_status_checks": [
          {
            "context": "Run Tests",
            "integration_id": null
          },
          {
            "context": "Build for Windows x64",
            "integration_id": null
          },
          {
            "context": "Build for Linux x64",
            "integration_id": null
          },
          {
            "context": "Build for Browser WASM",
            "integration_id": null
          }
        ],
        "strict_required_status_checks_policy": false
      }
    },
    {
      "type": "deletion"
    }
  ],
  "bypass_actors": []
}

